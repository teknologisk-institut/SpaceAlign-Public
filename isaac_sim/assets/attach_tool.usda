		}
	}

    def Scope "Looks"
    {
        def Material "BlackMaterial" (
            displayName = "BlackMaterial"
        )
        {
            token outputs:displacement.connect = </AttachTool/Looks/BlackMaterial/PreviewSurface.outputs:displacement>
            token outputs:surface.connect = </AttachTool/Looks/BlackMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.2)
                float inputs:metallic = 0.5
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:displacement
                token outputs:surface
            }
        }

        def Material "RedMaterial" (
            displayName = "RedMaterial"
        )
        {
            token outputs:displacement.connect = </AttachTool/Looks/RedMaterial/PreviewSurface.outputs:displacement>
            token outputs:surface.connect = </AttachTool/Looks/RedMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                float inputs:metallic = 0.5
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:displacement
                token outputs:surface
            }
        }
    }
