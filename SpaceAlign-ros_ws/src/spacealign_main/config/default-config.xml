<?xml version ="1.0"?>
<joint_constraints>
    
    <power>
        <max>8</max>
        <min>0</min>
    </power>
    <torque_norm>
        <max>1000</max>
        <min>-1000</min>
        <!-- <noise>0.2</noise> -->
    </torque_norm>
    <joint_level>
        <!-- <temperature>
            <max>60</max>
            <min>0</min>
        </temperature> -->
        <torque>
            <max>350</max>
            <min>-350</min>
            <!-- <tolerance>0.2</tolerance> -->
        </torque>
        <angle_velocity>
            <max>4</max>
            <min>-4</min>
            <!-- <tolerance>0.2</tolerance> -->
