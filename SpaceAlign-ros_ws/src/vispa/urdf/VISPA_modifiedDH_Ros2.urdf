<robot name="VISPA">

  <!-- Standard ROS(-industrial) frames -->
  <!-- inertials not needed here -->
  <link name="base_link"/>
  <link name="base"/>
  <link name="world"/>

  <link name="Link_0">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link0-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.627"/>
      <inertia ixx="0.00281845585208" ixy="0" ixz="0" iyy="0.00281883333333" iyz="0" izz="0.00379978918542"/>
      <origin xyz="0 0 0.0"/>
    </inertial>
  </link>

  <link name="Link_1">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link1-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="2.328"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.007" iyz="0.003" izz="0.008"/>
      <origin xyz="0 -0.029 -0.043"/>
    </inertial>
  </link>

  <link name="Link_2">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link2-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="3.995"/>
      <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.578" iyz="0" izz="0.574"/>
      <origin xyz="0.4 0 0.142"/>
    </inertial>
  </link>

  <link name="Link_3">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link3-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="2.328"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.008" iyz="0.003" izz="0.007"/>
      <origin xyz="0 0.043 0.029"/>
    </inertial>
  </link>

  <link name="Link_4">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link4-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="3.157"/>
      <inertia ixx="0.199" ixy="0" ixz="0" iyy="0.193" iyz="0.01" izz="0.01"/>
      <origin xyz="0 -0.043 -0.210"/>
    </inertial>
  </link>

  <link name="Link_5">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link5-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="2.695"/>
      <inertia ixx="0.029" ixy="0" ixz="0" iyy="0.006" iyz="-0.001" izz="0.027"/>
      <origin xyz="0 0.125 -0.007"/>
    </inertial>
  </link>

  <link name="Link_6">
    <visual>
      <geometry>
        <mesh filename="package://vispa/meshes/Link6-DHReference-PublicRelease.stl"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.924"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
      <origin xyz="0 0 0.0"/>
    </inertial>
  </link>

  <link name="RobotIq_Hand_E_base">
  </link>

  <link name="left_gripper">
  </link>

  <link name="right_gripper">
  </link>

   <!-- Standard ROS(-industrial) and Gazebo joints -->
  <joint name="base_link-link0" type="fixed">
    <parent link="base_link"/>
    <child link="Link_0"/>
    <!-- <origin xyz="0 0 0" rpy="0 0 ${2*C_1_DEGREE}"/> -->
  </joint>
  <joint name="base_link-base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <!-- <origin xyz="0 0 0" /> -->
  </joint>
  <joint name="world-base_link" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <!-- <origin xyz="0 0 0" /> -->
  </joint>

  <joint name="joint_J1" type="revolute">
    <parent link="Link_0"/>
    <child link="Link_1"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="10.09395689"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <joint name="joint_J2" type="revolute">
    <parent link="Link_1"/>
    <child link="Link_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="10.09395689"/>
    <origin xyz="0 0 0" rpy="1.57079632679 -1.57079632679 0"/>
  </joint>

  <joint name="joint_J3" type="revolute">
    <parent link="Link_2"/>
    <child link="Link_3"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="10.09395689"/>
    <origin xyz="0.8 0 0" rpy="0 0 -1.57079632679"/>
  </joint>

  <joint name="joint_J4" type="revolute">
    <parent link="Link_3"/>
    <child link="Link_4"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="10.09395689"/>
    <origin xyz="0 0.65 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="joint_J5" type="revolute">
    <parent link="Link_4"/>
    <child link="Link_5"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="10.09395689"/>
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  </joint>

  <joint name="joint_J6" type="revolute">
    <parent link="Link_5"/>
    <child link="Link_6"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="10.09395689"/>
    <origin xyz="0 0.325 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="vispa_to_robotiq" type="fixed">
    <parent link="Link_6"/>
    <child link="RobotIq_Hand_E_base"/>
    <origin xyz="0 0 0.08" rpy="1.57 0 0"/>
  </joint>

  <joint name="Slider_1" type="prismatic">
    <origin xyz="0.01125 -0.0019 -0.0357727" rpy="3.1415927 0. 0. "/>
    <parent link="RobotIq_Hand_E_base"/>
    <child link="left_gripper"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-0.05" upper="0.05" effort="10." velocity="0.1"/>
  </joint>

  <joint name="Slider_2" type="prismatic">
    <origin xyz="-0.01125 -0.0019 0.0357727" rpy="0. 0. 0."/>
    <parent link="RobotIq_Hand_E_base"/>
    <child link="right_gripper"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-0.05" upper="0.05" effort="10." velocity="0.1"/>
  </joint>

  <ros2_control name="VispaHardware" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/robot_joint_commands</param>
      <param name="joint_states_topic">/robot_joint_states</param>
    </hardware>
    <joint name="joint_J1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_J2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_J3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_J4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_J5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_J6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
</robot>