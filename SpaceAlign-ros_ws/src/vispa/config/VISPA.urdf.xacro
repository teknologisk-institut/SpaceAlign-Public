<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="VISPA">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import VISPA urdf file -->
    <xacro:include filename="$(find vispa)/urdf/VISPA_modifiedDH_Ros2.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="VISPA.ros2_control.xacro" />


    <xacro:VISPA_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
